# ── IA (opcional: sin nada configurado funciona el agente demo sin conexión) ──
# Opción 1: Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# Opción 2: cualquier gateway compatible con OpenAI (OmniRoute, OpenRouter, Ollama, LM Studio…)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# ── WhatsApp Cloud API (Meta) para el número real de la clínica ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── Mercado Pago (Checkout Pro). Sin token se usa el checkout de prueba ──
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de las notificaciones (panel de Mercado Pago → Webhooks). Sin ella el webhook rechaza todo (401).
MERCADOPAGO_WEBHOOK_SECRET=
